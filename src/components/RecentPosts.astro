---
import { getCollection } from 'astro:content';

interface Props {
	/** How many of the most recent posts to show. */
	limit?: number;
}

const { limit = 5 } = Astro.props;

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, limit);

// Every SVG in src/assets/svg is resolved at build time: `?url` gives the
// hashed public path, `?raw` the markup so we can read its viewBox.
const svgUrls = import.meta.glob<string>('../assets/svg/*.svg', {
	eager: true,
	query: '?url',
	import: 'default',
});
const svgSource = import.meta.glob<string>('../assets/svg/*.svg', {
	eager: true,
	query: '?raw',
	import: 'default',
});

const DEFAULT_SVG = 'flowers_default.svg';
const key = (name: string) => `../assets/svg/${name}`;

/** Resolves a frontmatter `cardImage` filename, falling back to the default. */
function illustration(name?: string) {
	const url = name ? svgUrls[key(name)] : undefined;
	const source = name ? svgSource[key(name)] : undefined;

	return {
		url: url ?? svgUrls[key(DEFAULT_SVG)],
		// A source narrower than the panel would be cropped top and bottom by
		// `cover`, so those get fitted to the width and anchored to the top
		// instead. Measured rather than hardcoded, so dropping in a new
		// portrait SVG needs no CSS.
		isPortrait: isNarrow(source ?? svgSource[key(DEFAULT_SVG)]),
	};
}

/** True when the artwork is narrower than the roughly 3:2 illustration panel. */
function isNarrow(source?: string) {
	const viewBox = source?.match(/viewBox="[\d.]+ [\d.]+ ([\d.]+) ([\d.]+)"/);
	if (!viewBox) return false;
	return Number(viewBox[1]) / Number(viewBox[2]) < 1.4;
}

const formatDate = (date: Date) =>
	date.toLocaleDateString('en-GB', {
		day: 'numeric',
		month: 'short',
		year: 'numeric',
	});
---

<section class="posts-container">
	<div class="header-section">
		<h2>Blog Posts</h2>
		<p>Notes on the things I find interesting or that I'm working on.</p>
		<a href="/blog" class="posts-btn">See more &rarr;</a>
	</div>

	{
		posts.map((post, i) => {
			const art = illustration(post.data.cardImage);
			return (
				<article class="card">
					<div class="card-meta">
						{post.data.series && <span class="card-tag">{post.data.series}</span>}
						<time class="card-date" datetime={post.data.pubDate.toISOString()}>
							{formatDate(post.data.pubDate)}
						</time>
					</div>
					<h3>
						<a href={`/blog/${post.id}/`}>{post.data.title}</a>
					</h3>
					<p>{post.data.description}</p>
					<div
						class:list={[
							'card-illustration',
							`panel-${(i % 5) + 1}`,
							art.isPortrait && 'panel-portrait',
						]}
						style={`background-image: url('${art.url}')`}
					/>
				</article>
			);
		})
	}
</section>

<style>
	/* Main layout: three equal columns, so every card is the same width.
	   The header occupies the first cell of the first row. */
	.posts-container {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 25px;
		box-sizing: border-box;
		/* Cancels the 2.1em horizontal padding `main` applies in global.css,
		   then re-adds a narrower gutter of its own, so this section runs
		   wider than the hero above it. No `width` here: the negative margins
		   only widen the box while it is auto-sized. */
		margin-inline: -2.1em;
		padding: 80px 45px 30px 45px;
		font-family: var(--font-manrope);

		/* Card palette, swapped wholesale for the dark theme below */
		--card-bg: #ffffff;
		--card-border: #333333;
		--card-ink: #222222;
		--card-body: #333333;
		--card-muted: #666666;
		--card-tag-bg: rgba(0, 0, 0, 0.06);
		--card-tag-ink: #444444;
		--card-hover: rgba(0, 0, 0, 0.05);
	}

	:global(:root[data-theme='dark']) .posts-container {
		--card-bg: #171b26;
		--card-border: rgba(229, 233, 240, 0.22);
		--card-ink: rgb(var(--text));
		--card-body: rgba(229, 233, 240, 0.82);
		--card-muted: rgba(229, 233, 240, 0.6);
		--card-tag-bg: rgba(229, 233, 240, 0.1);
		--card-tag-ink: rgba(229, 233, 240, 0.85);
		--card-hover: rgba(229, 233, 240, 0.08);
	}

	.posts-container * {
		box-sizing: border-box;
	}

	/* Header Area: first column, first row */
	.header-section {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding-top: 10px;
		/* Column width is fixed by the grid, so the wider gutter the header
		   used to have is recreated with padding instead */
		padding-right: 35px;
	}

	.header-section h2 {
		font-family: var(--font-lato);
		font-weight: 900;
		letter-spacing: -0.5px;
		color: rgb(var(--text));
		font-size: 3.2rem;
		margin-bottom: 20px;
		line-height: 1.1;
	}

	.header-section p {
		font-size: 1.05rem;
		margin-bottom: 30px;
		color: rgb(var(--text));
		opacity: 0.8;
	}

	/* Button Style */
	.posts-btn {
		display: inline-flex;
		align-items: center;
		padding: 12px 24px;
		background-color: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 8px;
		font-family: inherit;
		font-size: 0.95rem;
		color: var(--card-ink);
		text-decoration: none;
		transition: background-color 0.2s ease;
		cursor: pointer;
	}

	.posts-btn:hover {
		background-color: var(--card-hover);
	}

	/* Individual Card Style */
	.card {
		background-color: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 24px;
		padding: 26px;
		display: flex;
		flex-direction: column;
		/* Anchors the stretched link on the card title */
		position: relative;
	}

	/* Eyebrow row: series tag on the left, publication date on the right */
	.card-meta {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 14px;
	}

	.card-tag {
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--card-tag-ink);
		background-color: var(--card-tag-bg);
		padding: 4px 10px;
		border-radius: 999px;
		white-space: nowrap;
	}

	.card-date {
		font-size: 0.8rem;
		color: var(--card-muted);
		white-space: nowrap;
		/* Pushed right by auto margin rather than space-between, so a post
		   with no series still has its date sitting on the right */
		margin-left: auto;
	}

	.card h3 {
		font-family: var(--font-lato);
		font-weight: 700;
		letter-spacing: -0.25px;
		color: var(--card-ink);
		font-size: 1.6rem;
		margin-bottom: 16px;
	}

	.card h3 a {
		color: inherit;
		text-decoration: none;
	}

	/* Stretches the title link over the whole card so anywhere is clickable,
	   without nesting the illustration and text inside an anchor. */
	.card h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 16px;
	}

	.card h3 a:hover {
		text-decoration: underline;
	}

	.card p {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--card-body);
		margin-bottom: 24px;
		/* Allows paragraph to take available space, pushing image to bottom if text lengths differ */
		flex-grow: 1;
	}

	/* Illustration panel: a flat colour with the post's SVG over it. The
	   artwork itself comes from frontmatter, so only the colours live here. */
	.card-illustration {
		width: 100%;
		height: 215px;
		border-radius: 12px;
		border: 1px solid rgba(0, 0, 0, 0.1); /* Slight border to define the edge */
		background-repeat: no-repeat;
		background-position: center;
		background-size: cover;
	}

	/* Artwork narrower than the panel: fit the width and show the top of it,
	   rather than letting `cover` crop away everything but a middle band. */
	.panel-portrait {
		background-size: 100% auto;
		background-position: center top;
	}

	.panel-1 {
		background-color: #8990c7; /* Periwinkle */
	}
	.panel-2 {
		background-color: #fd84a4; /* Pink */
	}
	.panel-3 {
		background-color: #f2b263; /* Warm amber */
	}
	.panel-4 {
		background-color: #7fb3a5; /* Sage */
	}
	.panel-5 {
		background-color: #c79ad8; /* Lilac */
	}

	/* Responsive adjustments for smaller screens */
	@media (max-width: 960px) {
		.posts-container {
			grid-template-columns: repeat(2, 1fr);
		}
		.header-section {
			/* Header spans the full width and sits above the cards */
			grid-column: 1 / -1;
			align-items: center;
			text-align: center;
			padding-right: 0;
			margin-bottom: 15px;
		}
	}

	@media (max-width: 600px) {
		.posts-container {
			grid-template-columns: 1fr;
		}
	}
</style>
