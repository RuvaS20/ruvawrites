---
/**
 * A postcard: pink border, handwritten message on the left, stamp and
 * address lines on the right.
 *
 * The whole card scales to whatever container it is dropped into — every
 * dimension is expressed in `cqi` (1cqi = 1% of the container's width),
 * derived from the original 800px design, so it keeps its proportions at
 * any size. Give the parent a width and the card fills it.
 */
interface Props {
  /** Word across the top of the card. */
  heading?: string;
  /** Postmark text; each line break becomes a line in the circle. */
  postmark?: string;
  /** Alt text for the stamp photo. */
  stampLabel?: string;
  /** Extra class on the outer element, for sizing from the parent. */
  class?: string;
}

const {
  heading = 'POSTCARD',
  postmark = 'Air Mail\nOCT . 05 . 22\nHRE ZW',
  stampLabel = 'A 30-cent stamp showing a field',
  class: className,
} = Astro.props;
---

<div class:list={['postcard-wrap', className]}>
  <div class="postcard">
    <div class="header">
      <h1>{heading}</h1>
    </div>

    <div class="content">
      <!-- Left Side: the message -->
      <div class="msg-col">
        <p class="post-message">
          <slot name="message">
            No leaves are brown<br />
            I miss the seasons in Harare<br />
            My dying town<br />
            Thought I'd be cool in California<br />
            I'd make you proud<br />
            To think I almost had it going<br />
            But I let you down
          </slot>
        </p>
      </div>

      <div class="divider"></div>

      <!-- Right Side: stamp, address, sign-off -->
      <div class="address-col">
        <div class="stamp-area">
          <svg class="postmark-waves" viewBox="0 0 120 60" preserveAspectRatio="none" aria-hidden="true">
            <path pathLength="600" d="M2 8 q 14.75 -8 29.5 0 t 29.5 0 t 29.5 0 t 29.5 0" />
            <path pathLength="600" d="M2 22 q 14.75 -8 29.5 0 t 29.5 0 t 29.5 0 t 29.5 0" />
            <path pathLength="600" d="M2 36 q 14.75 -8 29.5 0 t 29.5 0 t 29.5 0 t 29.5 0" />
            <path pathLength="600" d="M2 50 q 14.75 -8 29.5 0 t 29.5 0 t 29.5 0 t 29.5 0" />
          </svg>
          <div class="postmark" aria-hidden="true">{postmark}</div>
          <div class="stamp" role="img" aria-label={stampLabel}></div>
        </div>

        <div class="address-lines">
          <div class="address-line"></div>
          <div class="address-line"></div>
          <div class="address-line"></div>
          <div class="address-line"></div>
        </div>

        <p class="sign-off">
          <slot name="sign-off">from Silas<br />wherever you are</slot>
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Buda:wght@300&family=The+Girl+Next+Door&display=swap');

  /* Establishes the container that every cqi length below resolves against. */
  .postcard-wrap {
    container-type: inline-size;
    width: 100%;
  }

  .postcard {
    --pink-border: #d66d89;
    --cream-bg: #f3efe9;
    --dark-ink: #3b3938;

    /* The pink "border" is the card's own background; the cream face is
       painted by .postcard::before, inset to leave the pink showing. */
    background-color: var(--pink-border);
    border: none;
    border-radius: 2cqi;
    z-index: 1;

    width: 100%;
    aspect-ratio: 1.5;
    padding: 4.375cqi 5cqi;
    display: flex;
    flex-direction: column;
    color: var(--dark-ink);
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
  }

  .postcard::before {
    content: '';
    position: absolute;
    inset: 2.5cqi; /* the pink gap that reads as a border */
    background-color: var(--cream-bg);
    border-radius: 2cqi;
    z-index: -1;
  }

  .header {
    text-align: center;
    margin-bottom: 3.125cqi;
  }

  .header h1 {
    font-family: 'Buda', serif;
    font-size: 7cqi;
    margin: 0;
    letter-spacing: 0.375cqi;
    line-height: 1;
  }

  .content {
    display: flex;
    flex-grow: 1;
    gap: 3.75cqi;
  }

  .msg-col {
    flex: 1.1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .post-message {
    font-family: 'The Girl Next Door', cursive;
    font-size: 2.8cqi;
    line-height: 1.3;
    text-align: center;
    margin: 0;
    transform: rotate(-1deg); /* slight rotation for a handmade feel */
  }

  .divider {
    width: 0.22cqi;
    background-color: var(--dark-ink);
    height: 95%;
    align-self: flex-start;
    margin-top: 1.25cqi;
  }

  .address-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .stamp-area {
    --u: 0.325cqi; /* master scale — the stamp is drawn in multiples of it */
    display: flex;
    justify-content: flex-end;
    align-items: center; /* leaves room for the paper ring above/below */
    position: relative;
    margin-bottom: 3.75cqi;
    height: calc(49 * var(--u));
  }

  /* --- Stamp: perforated "lettuce" edge + postmark --- */

  /* The stamp artwork. The photo is embedded as a data URI so the component
     carries its own image and needs no file alongside it. */
  .stamp {
    position: relative;
    width: calc(36 * var(--u));
    height: calc(45 * var(--u));
    box-sizing: border-box;
    display: flex;
    align-items: flex-end;
    padding: calc(1.5 * var(--u)) calc(2 * var(--u));
    font-family: Arial, Helvetica, sans-serif;
    font-size: calc(7 * var(--u));
    color: #fffff8dd;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    background: url('data:image/jpeg;base64,') center / cover no-repeat;
    z-index: 3;
  }

  /* The white perforated paper. It sits ON TOP of the artwork and is
     slightly larger than it; the mask below keeps only the scalloped
     border ring — the middle is punched out so the photo shows through.
     It must NOT be a parent of the artwork: a mask clips descendants,
     so wrapping the photo in this would erase the photo. */
  .stamp::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: calc(40 * var(--u));
    height: calc(49 * var(--u));
    background: #fffff9;
    -webkit-mask:
      radial-gradient(farthest-side at 50% 0%, #0000 60%, #000 0) calc(-2.25 * var(--u)) 0 / calc(4.5 * var(--u)) calc(2.25 * var(--u)) repeat-x,
      radial-gradient(farthest-side at 50% 100%, #0000 60%, #000 0) calc(-2.25 * var(--u)) 100% / calc(4.5 * var(--u)) calc(2.25 * var(--u)) repeat-x,
      radial-gradient(farthest-side at 0% 50%, #0000 60%, #000 0) 0 calc(-2.25 * var(--u)) / calc(2.25 * var(--u)) calc(4.5 * var(--u)) repeat-y,
      radial-gradient(farthest-side at 100% 50%, #0000 60%, #000 0) 100% calc(-2.25 * var(--u)) / calc(2.25 * var(--u)) calc(4.5 * var(--u)) repeat-y;
    mask:
      radial-gradient(farthest-side at 50% 0%, #0000 60%, #000 0) calc(-2.25 * var(--u)) 0 / calc(4.5 * var(--u)) calc(2.25 * var(--u)) repeat-x,
      radial-gradient(farthest-side at 50% 100%, #0000 60%, #000 0) calc(-2.25 * var(--u)) 100% / calc(4.5 * var(--u)) calc(2.25 * var(--u)) repeat-x,
      radial-gradient(farthest-side at 0% 50%, #0000 60%, #000 0) 0 calc(-2.25 * var(--u)) / calc(2.25 * var(--u)) calc(4.5 * var(--u)) repeat-y,
      radial-gradient(farthest-side at 100% 50%, #0000 60%, #000 0) 100% calc(-2.25 * var(--u)) / calc(2.25 * var(--u)) calc(4.5 * var(--u)) repeat-y;
  }

  /* Circular cancellation mark, smudged via a speckled mask */
  .postmark {
    position: absolute;
    top: 55%;
    right: calc(45 * var(--u)); /* centred on the stamp's left edge */
    transform: translate(50%, -50%) rotate(13deg);
    width: calc(36 * var(--u));
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    white-space: pre-wrap;
    text-align: center;
    font-family: Arial, Helvetica, sans-serif;
    font-size: calc(4.5 * var(--u));
    line-height: 2;
    color: #236c;
    z-index: 4;
    background:
      radial-gradient(farthest-side, #0000 95%, #2369 0),
      linear-gradient(#2369 0 0) 50% 40% / 75% 2.25% no-repeat,
      linear-gradient(#2369 0 0) 50% 60% / 75% 2.25% no-repeat;
    -webkit-mask:
      radial-gradient(#0008, #0000 70%) 3% 3% / 5% 5%,
      radial-gradient(#000c, #0000 50%) 5% 5% / 7% 7%,
      radial-gradient(#0008, #0000 40%) 7% 7% / 11% 11%,
      radial-gradient(#0005, #0000 30%) 11% 11% / 13% 13%,
      radial-gradient(#000f, #0000 70%) 5% 5% / 13% 11%,
      radial-gradient(#000a, #0000 50%) 7% 9% / 14% 12%,
      radial-gradient(#0008, #0000 30%) 9% 11% / 9% 8%;
    mask:
      radial-gradient(#0008, #0000 70%) 3% 3% / 5% 5%,
      radial-gradient(#000c, #0000 50%) 5% 5% / 7% 7%,
      radial-gradient(#0008, #0000 40%) 7% 7% / 11% 11%,
      radial-gradient(#0005, #0000 30%) 11% 11% / 13% 13%,
      radial-gradient(#000f, #0000 70%) 5% 5% / 13% 11%,
      radial-gradient(#000a, #0000 50%) 7% 9% / 14% 12%,
      radial-gradient(#0008, #0000 30%) 9% 11% / 9% 8%;
  }

  /* Wavy "killer bars" trailing off to the left of the cancellation mark */
  .postmark-waves {
    position: absolute;
    top: 55%;
    right: calc(56 * var(--u)); /* starts where the circle's left edge is */
    width: calc(34 * var(--u));
    height: calc(20 * var(--u));
    transform: translateY(-50%) rotate(3deg); /* same tilt as the circle */
    transform-origin: right center;
    overflow: visible;
    z-index: 4;
    opacity: 0.4;
  }

  .postmark-waves path {
    fill: none;
    stroke: #236c;
    stroke-width: 3;
    stroke-linecap: round;
    /* pathLength="600" on each path normalises its length, so these
       two numbers hide the line exactly end to end before it draws */
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: stamp 1.2s ease forwards;
  }

  /* Draw the bars top to bottom rather than all at once */
  .postmark-waves path:nth-child(2) { animation-delay: 0.08s; }
  .postmark-waves path:nth-child(3) { animation-delay: 0.16s; }
  .postmark-waves path:nth-child(4) { animation-delay: 0.24s; }

  @keyframes stamp {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .postmark-waves path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  .address-lines {
    display: flex;
    flex-direction: column;
    gap: 3.5cqi;
    width: 85%;
    margin-left: 1.25cqi;
  }

  .address-line {
    border-bottom: max(1px, 0.125cqi) solid var(--dark-ink);
    width: 100%;
  }

  .sign-off {
    font-family: 'The Girl Next Door', cursive;
    font-size: 2cqi;
    text-align: right;
    margin-top: auto;
    margin-bottom: 1.25cqi;
    margin-right: 1.25cqi;
    line-height: 1.1;
    transform: rotate(-12deg);
  }
</style>
