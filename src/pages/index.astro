---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Postcard from '../components/Postcard.astro';
import RecentPosts from '../components/RecentPosts.astro';
import { Icon } from 'astro-icon/components';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div id="hero">
				<!-- Top row: the "HI!" badge and the intro line -->
				<div id="hero-top">
					<div class="badge-horizontal">
						<h1>HI!</h1>
						<span class="hi-illustration">
							<Icon name="ruva_illustration" />
						</span>
					</div>
					<h1 class="hero-heading">I'm <span class="sketch-font-heading">RUVA</span> & I am available for</h1>
				</div>

				<!-- Bottom row: stat card on the left, heading + postcard on the right -->
				<div id="hero-bottom">
					<div class="left-card">
						<!-- Corner "stickers", pinned to the card -->
						<img class="corner-illustration top-left" src="/cat3.svg" alt="" />
						<span class="corner-illustration bottom-right squiggle">
							<Icon name="squiggle" />
						</span>

						<div class="card-content">
							<div class="stat-row">
								<span class="stat-num">288</span>
								<span class="stat-word sketch-font-heading">MONTHS</span>
								<span class="stat-plus">+</span>
							</div>

							<p class="passion-text">
								OF ENJOYING ALL THINGS WEIRD AND WONDERFUL, NOT EXCLUDING TEACHING COMPUTERS HOW TO SEE, MAKING INTERWEB EXPERIENCES, WRITING, SINGING, READING, AND HELPING CATS IN THEIR QUEST FOR WORLD DOMINATION.
							</p>
						</div>
					</div>

					<div class="right-col">
						<h1 class="hero-heading with-code sketch-font-heading">dilly & dally.</h1>
						<Postcard class="hero-postcard" />
					</div>
				</div>
			</div>

			<RecentPosts />
		</main>
		<Footer />
	</body>
</html>

<style>
	/* This page runs full width, overriding the fixed 720px `main` in global.css. */
	main {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
	}

	/* -- Hero section -- */
	#hero {
		/* Hero palette. Scoped here because these colours are specific to
		   this section rather than part of the site-wide theme. */
		--hero-card-bg: #a9cdc7;      /* sage green card */
		--hero-card-border: rgba(150, 150, 150, 0.3);
		--hero-accent: #f17751;       /* terracotta, used for the badge and squiggle */
		--hero-ink: #000;             /* text on the sage card */

		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 25px 0 30px 0;
	}

	/* Typography scale */
	.hero-heading {
		font-family: var(--font-lato);
		font-size: clamp(2rem, 5vw, 6rem);
		text-transform: uppercase;
		margin: 0;
		line-height: 1.1;
		font-weight: 900;
	}
	.sketch-font-heading {
		font-family: var(--font-cabin-sketch);
		font-size: clamp(2.6rem, 5.6vw, 6.6rem);
		font-weight: 700;
	}

	/* Top row */
	#hero-top {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
		padding-top: 2.5rem;
	}

	.badge-horizontal {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		border: 2px solid currentColor;
		border-radius: 50px;
		padding: 0.5rem 1.5rem;
		font-weight: bold;
		white-space: nowrap;
		background: var(--hero-accent);
	}

	/* Circular avatar sitting inside the badge */
	.hi-illustration {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 4rem;
		height: 4rem;
		border-radius: 50%;
		overflow: hidden;
	}
	.hi-illustration :global(svg) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Bottom row */
	#hero-bottom {
		display: flex;
		gap: 1.5rem;
		align-items: stretch;
		margin-top: 1rem;
		padding-bottom: 1rem;
	}

	/* --- Left card --- */
	.left-card {
		flex: 1.2;
		position: relative; /* anchors the absolutely positioned corner stickers */
		background: var(--hero-card-bg);
		border: 1px solid var(--hero-card-border);
		border-radius: 24px;
		color: var(--hero-ink);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 4rem 3rem; /* keeps the text clear of the corner stickers */
	}

	.corner-illustration {
		position: absolute;
	}
	.top-left {
		top: 1.5rem;
		left: 1.5rem;
		width: clamp(3rem, 5vw, 4.5rem);
		height: auto;
	}
	.bottom-right {
		bottom: 1.5rem;
		right: 1.5rem;
	}
	.squiggle {
		display: inline-flex;
		color: var(--hero-accent);
	}
	.squiggle :global(svg) {
		width: clamp(4rem, 7vw, 6.5rem);
		height: auto;
		display: block;
	}

	.card-content {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		width: 100%;
		max-width: 550px; /* keeps the paragraph from getting too wide */
		z-index: 1; /* keeps the text above the stickers */
	}

	/* The "288 MONTHS +" line */
	.stat-row {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		line-height: 1;
	}
	.stat-num {
		font-size: clamp(4rem, 8vw, 6.5rem);
		font-weight: 900;
	}
	.stat-word {
		font-size: clamp(4rem, 7.5vw, 6.5rem);
		text-transform: uppercase;
		padding-top: 12px;
	}
	.stat-plus {
		font-size: clamp(3rem, 6vw, 5rem);
		color: var(--hero-accent);
		font-weight: 900;
		transform: translateY(-15px); /* lifts the plus towards the cap height */
	}

	.passion-text {
		font-size: 1.1rem;
		line-height: 1.6;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		margin: 0;
		text-align: justify;
		padding-right: 2rem;
	}

	/* --- Right column --- */
	.right-col {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.with-code {
		text-align: right;
		padding-right: 1rem;
	}
	/* The postcard sizes itself to this slot and brings its own background. */
	.hero-postcard {
		margin-top: auto; /* sits at the bottom, level with the left card */
	}

	@media (max-width: 900px) {
		#hero-bottom {
			flex-direction: column;
		}
		.with-code {
			text-align: left;
		}
		/* Nothing left to stretch into, so let the stack sit at the top. */
		.left-card {
			justify-content: flex-start;
		}
	}
</style>
